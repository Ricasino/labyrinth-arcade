[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/menu.gd" id="1_menu"]
[ext_resource type="Theme" path="res://scenes/ui_theme.tres" id="2_theme"]
[ext_resource type="Resource" path="res://modifiers/catalog.tres" id="3_catalog"]

[node name="Menu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_menu")
catalog = ExtResource("3_catalog")

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
horizontal_scroll_mode = 0

[node name="Center" type="CenterContainer" parent="Scroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Margin" type="MarginContainer" parent="Scroll/Center"]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 20

[node name="VBox" type="VBoxContainer" parent="Scroll/Center/Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Scroll/Center/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.823529, 0.247059, 1)
theme_override_constants/outline_size = 10
theme_override_font_sizes/font_size = 60
text = "Labyrinth Arcade"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Scroll/Center/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.772549, 0.54902, 1, 1)
text = "Scegli come giocare"
horizontal_alignment = 1

[node name="Modes" type="GridContainer" parent="Scroll/Center/Margin/VBox"]
layout_mode = 2
theme_override_constants/h_separation = 14
theme_override_constants/v_separation = 14
columns = 2

[node name="ArcadeButton" type="Button" parent="Scroll/Center/Margin/VBox/Modes"]
unique_name_in_owner = true
custom_minimum_size = Vector2(420, 0)
layout_mode = 2
text = "Arcade
Regole a sorpresa dal livello 2"

[node name="ClassicButton" type="Button" parent="Scroll/Center/Margin/VBox/Modes"]
unique_name_in_owner = true
custom_minimum_size = Vector2(420, 0)
layout_mode = 2
text = "Classico
Solo il labirinto"

[node name="ChaosButton" type="Button" parent="Scroll/Center/Margin/VBox/Modes"]
unique_name_in_owner = true
custom_minimum_size = Vector2(420, 0)
layout_mode = 2
text = "Caos
2-3 regole insieme, subito"

[node name="DailyButton" type="Button" parent="Scroll/Center/Margin/VBox/Modes"]
unique_name_in_owner = true
custom_minimum_size = Vector2(420, 0)
layout_mode = 2
text = "Sfida del giorno"

[node name="TrainingLabel" type="Label" parent="Scroll/Center/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.772549, 0.54902, 1, 1)
text = "Allenamento: gioca una regola sola"
horizontal_alignment = 1

[node name="TrainingGrid" type="GridContainer" parent="Scroll/Center/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
theme_override_constants/h_separation = 10
theme_override_constants/v_separation = 10
columns = 4

[node name="Description" type="Label" parent="Scroll/Center/Margin/VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 34)
layout_mode = 2
theme_override_colors/font_color = Color(0.92, 0.88, 1, 1)
theme_override_font_sizes/font_size = 22
horizontal_alignment = 1
